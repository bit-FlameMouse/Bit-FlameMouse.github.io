---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkRow from '../components/LinkRow.astro';
import { categories, counts, entries, featured, groups } from '../data/library';

const latest = featured.slice(0, 3);
---

<BaseLayout title="首页">
  <section class="hero">
    <p class="eyebrow">TPM · 具身智能 / 智能驾驶</p>

    <div class="hero-grid">
      <div>
        <h1 class="hero-name">
          李辰麾
          <span class="hero-name-en">Li Chenhui / Technical Program Manager</span>
        </h1>
      </div>

      <div>
        <p class="hero-lede">
          在具身智能与智能驾驶方向做技术项目管理。把<strong>不确定的技术问题</strong>拆成可验证的里程碑，把跨团队的协作沉淀成可复用的方法。
        </p>
        <span class="status"><i class="status-dot" aria-hidden="true"></i>索引持续更新</span>
      </div>
    </div>

    <dl class="hero-meta">
      <div>
        <dt>方向</dt>
        <dd>具身智能 · 智能驾驶</dd>
      </div>
      <div>
        <dt>角色</dt>
        <dd>技术项目管理（TPM）</dd>
      </div>
      <div>
        <dt>索引</dt>
        <dd>{entries.length} 篇 / {categories.length} 类</dd>
      </div>
      <div>
        <dt>邮箱</dt>
        <dd><a href="mailto:lichwork0@gmail.com">lichwork0@gmail.com</a></dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-side">
        <span class="section-num">01</span>
        <span class="section-name">精选</span>
      </div>

      <div class="section-main">
        <div class="section-head">
          <div>
            <h2 class="section-title" data-reveal>先看这几篇</h2>
            <p class="section-desc" data-reveal>
              每篇都是一次具体问题的处理记录，不是概念科普。正文在飞书，点击直接跳转。
            </p>
          </div>
          <a class="text-link" href="/library/">全部 {entries.length} 篇 →</a>
        </div>

        <div class="rows">
          {
            latest.map((entry, index) => (
              <LinkRow entry={entry} delay={index * 60} />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="categories">
    <div class="section-inner">
      <div class="section-side">
        <span class="section-num">02</span>
        <span class="section-name">分类</span>
      </div>

      <div class="section-main">
        <div class="section-head">
          <div>
            <h2 class="section-title" data-reveal>三个方向</h2>
            <p class="section-desc" data-reveal>
              技术、方法、经验分开存放。技术笔记写机制，管理知识写方法，管理心得写判断。
            </p>
          </div>
        </div>

        <div class="cat-grid">
          {
            groups.map((group, index) => (
              <a
                class="cat"
                href={`/library/#${group.id}`}
                data-reveal
                style={`--d:${index * 70}ms`}
              >
                <span class="cat-top">
                  <span class="cat-num">{String(index + 1).padStart(2, '0')}</span>
                  <span>{group.en}</span>
                </span>
                <h3>{group.name}</h3>
                <p>{group.desc}</p>
                <span class="cat-foot">
                  <span class="cat-count">{counts[group.id]} 篇</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="section-inner">
      <div class="section-side">
        <span class="section-num">03</span>
        <span class="section-name">联系</span>
      </div>

      <div class="section-main">
        <div class="contact">
          <div>
            <h2 class="section-title" data-reveal>有具体的问题，欢迎来信</h2>
            <p class="section-desc" data-reveal>
              文档权限、内容讨论、项目上的具体问题，都可以直接发邮件。写清背景和你想确认的点，回复会快很多。
            </p>
            <p style="margin-top:24px">
              <a class="btn btn--solid" href="mailto:lichwork0@gmail.com">写邮件 ↗</a>
            </p>
          </div>

          <div class="contact-lines" data-reveal>
            <div class="contact-line">
              <span>邮箱</span>
              <span><a href="mailto:lichwork0@gmail.com">lichwork0@gmail.com</a></span>
            </div>
            <div class="contact-line">
              <span>GitHub</span>
              <span>
                <a href="https://github.com/bit-FlameMouse" target="_blank" rel="noopener noreferrer">
                  bit-FlameMouse
                </a>
              </span>
            </div>
            <div class="contact-line">
              <span>时区</span>
              <span>UTC+8</span>
            </div>
            <div class="contact-line">
              <span>文档权限</span>
              <span>标注「需申请」的请来信</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
